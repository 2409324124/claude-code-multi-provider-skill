# Claude Code Multi-Provider Router Configuration
# Copy this file to .env and fill in your actual values.

# Router settings
ROUTER_PORT=8084
ROUTER_HOST=127.0.0.1
ROUTER_TIMEOUT=20
COOLDOWN_SECONDS=300

# --- Backend: GPT via raine/claude-code-proxy ---
GPT_BASE_URL=http://127.0.0.1:18765
GPT_MODEL=gpt-5.5
# Usually unset: raine/claude-code-proxy handles Codex/ChatGPT device auth.
# GPT_API_KEY=
# GPT returns 400 for "no quota" — treat as retryable
GPT_EXTRA_RETRYABLE=400
GPT_FALLBACKS=mimo,deepseek,gemini

# --- Backend: MiMo Token Plan ---
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic
MIMO_MODEL=mimo-v2.5-pro
# Required unless your MiMo endpoint is authenticated by another local proxy.
# MIMO_API_KEY=
MIMO_FALLBACKS=gemini,deepseek

# --- Backend: DeepSeek Official ---
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-pro
# Required for DeepSeek's official Anthropic-compatible endpoint.
# DEEPSEEK_API_KEY=
DEEPSEEK_FALLBACKS=gemini,mimo,gpt

# --- Backend: Gemini via local proxy ---
GEMINI_BASE_URL=http://127.0.0.1:8083
GEMINI_MODEL=claude-3-5-haiku-latest
# Usually unset: the Gemini proxy handles Google/Vertex auth.
# GEMINI_API_KEY=
GEMINI_FALLBACKS=deepseek,mimo

# --- Routing rules: model name contains keyword → backend ---
ROUTE_OPUS_KEYWORD=opus
ROUTE_OPUS_BACKEND=gpt

ROUTE_SONNET_KEYWORD=sonnet
ROUTE_SONNET_BACKEND=deepseek

ROUTE_HAIKU_KEYWORD=haiku
ROUTE_HAIKU_BACKEND=mimo

ROUTE_SUBAGENT_KEYWORD=subagent
ROUTE_SUBAGENT_BACKEND=gemini

# Default backend if no keyword matches
DEFAULT_BACKEND=gemini
